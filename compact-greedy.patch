+# SPDX-License-Identifier: Apache-2.0
+"""Immutable per-execution sampling decision; no torch or runtime imports.
+
+The selector reads only scheduler-broadcast facts and cached request parameters.
+It never uses output history, processor state, device tensors or rank-local
+timing to choose a collective. Unsupported batches retain full-vocabulary
+logits. The context is confined to one compute_logits call, never sampling.
+"""
+
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass, field
+from enum import Enum
+
+
+class SamplingMode(Enum):
+    FULL = "full"
+    COMPACT_GREEDY = "compact_greedy"
+
+
+@dataclass(frozen=True)
+class BatchSamplingPlan:
+    mode: SamplingMode
+    request_ids: tuple[str, ...] = ()
+    # Strong references prevent object-address reuse before sampling retires.
+    request_states: tuple[object, ...] = field(default=(), repr=False, compare=False)
+    projector_identity: int | None = None
+    local_vocab_start: int = 0
+    local_vocab_size: int = 0
+
+
+FULL_PLAN = BatchSamplingPlan(SamplingMode.FULL)
+_LOGITS_PLAN: ContextVar[BatchSamplingPlan] = ContextVar("stateaxis_logits_plan", default=FULL_PLAN)
+
+
+def current_logits_plan() -> BatchSamplingPlan:
+    return _LOGITS_PLAN.get()
+
+
+@contextmanager
+def logits_plan_scope(plan: BatchSamplingPlan):
+    token = _LOGITS_PLAN.set(plan)
+    try:
+        yield
+    finally:
+        _LOGITS_PLAN.reset(token)
+
+
+def plain_decode_request_ids(scheduler_output, requests) -> tuple[str, ...] | None:
+    """Return eligible IDs, or None for whole-batch full-logits fallback.
+
+NewRequestData and CachedRequestData carry computed positions from the same
+RPC broadcast. Do not substitute asynchronously corrected worker counters.
+The conservative request-lifetime exclusions avoid depending on evolving
+min-tokens, thinking-budget, grammar or history-dependent processor state.
+"""
+    if (scheduler_output.total_num_scheduled_tokens <= 0
+            or scheduler_output.has_structured_output_requests
+            or scheduler_output.pending_structured_output_tokens
+            or scheduler_output.scheduled_spec_decode_tokens
+            or scheduler_output.scheduled_encoder_inputs):
+        return None
+    scheduled = scheduler_output.num_scheduled_tokens
+    if not scheduled or any(count != 1 for count in scheduled.values()):
+        return None
+    cached = scheduler_output.scheduled_cached_reqs
+    computed = dict(zip(cached.req_ids, cached.num_computed_tokens))
+    computed.update((row.req_id, row.num_computed_tokens) for row in scheduler_output.scheduled_new_reqs)
+    for req_id in scheduled:
+        request = requests.get(req_id)
+        if request is None:
+            return None
+        params = request.sampling_params
+        if (params is None or params.sampling_type.name != "GREEDY"
+                or params.logprobs is not None or params.prompt_logprobs is not None
+                or params.logprob_token_ids is not None
+                or params.structured_outputs is not None
+                or params.thinking_token_budget is not None
+                or params.min_tokens != 0 or params.logit_bias
+                or params.allowed_token_ids or params.bad_words_token_ids
+                or params.presence_penalty != 0 or params.frequency_penalty != 0
+                or params.repetition_penalty != 1
+                or request.lora_request is not None or request.mm_features
+                or request.prompt_embeds is not None
+                or computed.get(req_id, -1) < request.num_prompt_tokens):
+            return None
+    # This is only a generation guard, not the model's row ordering.
+    return tuple(sorted(scheduled))
