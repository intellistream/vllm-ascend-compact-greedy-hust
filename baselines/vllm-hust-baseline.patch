From 76ae9e64a3b62b232f80e8949c5e56db240227b0 Mon Sep 17 00:00:00 2001
From: "Shuhao Zhang (Tony)" <5267690+ShuhaoZhangTony@users.noreply.github.com>
Date: Fri, 28 Aug 2026 09:29:32 +0800
Subject: [PATCH 1/2] fix: detect vllm-hust distribution version

Assisted-by: OpenAI Codex
---
 .../test_platform_package_version.py          | 30 +++++++++++++++++++
 vllm/platforms/__init__.py                    | 18 +++++++----
 2 files changed, 42 insertions(+), 6 deletions(-)
 create mode 100644 tests/platforms/test_platform_package_version.py

diff --git a/tests/platforms/test_platform_package_version.py b/tests/platforms/test_platform_package_version.py
new file mode 100644
index 000000000..1c092556c
--- /dev/null
+++ b/tests/platforms/test_platform_package_version.py
@@ -0,0 +1,30 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from importlib.metadata import PackageNotFoundError
+
+import pytest
+
+from vllm.platforms import vllm_version_matches_substr
+
+
+def test_vllm_hust_distribution_name_is_supported(monkeypatch: pytest.MonkeyPatch):
+    def fake_version(package_name: str) -> str:
+        if package_name == "vllm-hust":
+            return "0.23.1+empty"
+        raise PackageNotFoundError(package_name)
+
+    monkeypatch.setattr("importlib.metadata.version", fake_version)
+
+    assert vllm_version_matches_substr("empty")
+    assert not vllm_version_matches_substr("cpu")
+
+
+def test_missing_vllm_distributions_raise(monkeypatch: pytest.MonkeyPatch):
+    def missing_version(package_name: str) -> str:
+        raise PackageNotFoundError(package_name)
+
+    monkeypatch.setattr("importlib.metadata.version", missing_version)
+
+    with pytest.raises(PackageNotFoundError, match="vllm, vllm-hust"):
+        vllm_version_matches_substr("cpu")
diff --git a/vllm/platforms/__init__.py b/vllm/platforms/__init__.py
index 647793ab8..807a97522 100644
--- a/vllm/platforms/__init__.py
+++ b/vllm/platforms/__init__.py
@@ -30,14 +30,20 @@ def vllm_version_matches_substr(substr: str) -> bool:
     """
     from importlib.metadata import PackageNotFoundError, version
 
-    try:
-        vllm_version = version("vllm")
-    except PackageNotFoundError as e:
+    package_names = ("vllm", "vllm-hust")
+    for package_name in package_names:
+        try:
+            vllm_version = version(package_name)
+            break
+        except PackageNotFoundError:
+            continue
+    else:
         logger.warning(
-            "The vLLM package was not found, so its version could not be "
-            "inspected. This may cause platform detection to fail."
+            "Neither the vLLM nor vLLM-HUST package was found, so the "
+            "version could not be inspected. This may cause platform "
+            "detection to fail."
         )
-        raise e
+        raise PackageNotFoundError(", ".join(package_names))
     return substr in vllm_version
 
 
-- 
2.34.1


